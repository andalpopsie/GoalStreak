{
  "name": "goalstreakapp",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --config config/jest.config.js",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "detox test",
    "test:e2e:build": "detox build",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:ios": "node scripts/ios-pre-launch-testing.js",
    "test:ios:smoke": "jest --testPathPattern=ios-testing --testNamePattern='smoke'",
    "test:ios:devices": "jest --testPathPattern=ios-testing --testNamePattern='device'",
    "test:ios:flows": "jest --testPathPattern=ios-testing --testNamePattern='flow'",
    "test:ios:features": "jest --testPathPattern=ios-testing --testNamePattern='ios.*feature'",
    "test:ios:comprehensive": "npm run test:ios",
    "test:emulator": "firebase emulators:exec --only firestore --config firebase/firebase.json --project demo-goalstreak \"npx jest --config config/jest.emulator.config.js\"",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "build:development": "eas build --profile development --platform all",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all",
    "build:production:ios": "eas build --profile production-ios --platform ios",
    "build:production:android": "eas build --profile production-android --platform android",
    "submit:production": "eas submit --profile production --platform all",
    "submit:ios": "eas submit --profile production --platform ios",
    "submit:android": "eas submit --profile production --platform android",
    "validate:build": "node scripts/validate-build.js",
    "validate:comprehensive": "node scripts/comprehensive-validation.js",
    "validate:all": "npm run validate:comprehensive",
    "prebuild:production": "npm run validate:build",
    "prebuild:production:ios": "npm run validate:build",
    "prebuild:production:android": "npm run validate:build",
    "presubmit:production": "npm run validate:comprehensive",
    "ios:build-and-submit": "node scripts/ios-production-build-and-submit.js",
    "ios:configure-app-store": "node scripts/configure-app-store-connect.js",
    "ios:setup-credentials": "node scripts/setup-eas-credentials.js",
    "ios:validate": "node scripts/ios-pre-submission-validation.js",
    "ios:full-deployment": "npm run ios:validate && npm run ios:configure-app-store && npm run ios:build-and-submit",
    "increment-build": "node scripts/increment-build.js",
    "sync-build-number": "node scripts/sync-build-number.js",
    "sync-app-icon": "node scripts/sync-app-icon.js",
    "feedback": "node scripts/view-feedback.js",
    "changelog": "node scripts/update-changelog.js",
    "changelog:dry": "node scripts/update-changelog.js --dry-run",
    "cleanup:storage": "node scripts/cleanup-storage.js",
    "cleanup:directory": "node scripts/cleanup-and-organize-directory.js",
    "cleanup:all": "npm run cleanup:directory && npm run lint --fix"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.7",
    "expo": "54.0.21",
    "expo-auth-session": "~7.0.8",
    "expo-crypto": "~15.0.7",
    "expo-file-system": "~19.0.14",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "^15.0.7",
    "expo-network": "~8.0.7",
    "expo-notifications": "~0.32.12",
    "expo-status-bar": "~3.0.8",
    "firebase": "^12.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-purchases": "^10.2.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/js": "^9.34.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "conventional-changelog-cli": "^5.0.0",
    "detox": "^20.40.2",
    "detox-cli": "^20.0.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "fast-check": "4.9.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^14.19.1",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.13",
    "react-test-renderer": "^19.0.0",
    "ts-jest": "^29.4.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0"
  },
  "private": true
}
