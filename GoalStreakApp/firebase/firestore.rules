rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──

    // Check if the requesting user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the requesting user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the requesting user is a member of a group
    function isGroupMember(groupData) {
      return isAuthenticated() && request.auth.uid in groupData.memberIds;
    }

    // Check if the requesting user is the admin of a group
    function isGroupAdmin(groupData) {
      return isAuthenticated() && request.auth.uid == groupData.adminId;
    }

    // ── Users ──
    // Any authenticated user can read profiles (needed for friend suggestions,
    // search, and displaying names/avatars in the social feed and groups).
    // Only the owner can write their own profile.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ── User Profiles (social profile mirror; doc id = userId) ──
    // Authenticated users can read (friend search by email, names/avatars in
    // requests and feed). Only the owner can write/delete their own profile.
    match /userProfiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ── Social Settings (doc id = userId) ──
    // Authenticated users can read (e.g. checking a recipient's notification
    // preference before notifying). Only the owner can write their settings.
    match /socialSettings/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ── Usernames (uniqueness registry; doc id = username → { userId }) ──
    // Anyone authenticated can read for availability checks. A user may only
    // reserve/release a username tied to their own uid. Usernames are immutable.
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow update: if false;
    }

    // ── Habits ──
    match /habits/{habitId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // ── Completions ──
    match /completions/{completionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // ── Streaks ──
    match /streaks/{streakId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Friends ──
    match /friends/{friendId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.userId
            || request.auth.uid == resource.data.friendId);
      allow write: if isAuthenticated();
    }

    // ── Friend Requests ──
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.fromUserId;
      allow update: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
    }

    // ── Activities (main feed) ──
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // ── Comments (on activity feed posts) ──
    // Any authenticated user can read comments (mirrors activity feed reads).
    // Author can create their own comment; comments are immutable.
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    // ── Timer States ──
    match /timerStates/{timerId} {
      allow read, write: if isAuthenticated();
    }

    // ── Timer Sessions (completed timer records; has userId) ──
    // Mirrors completions: authenticated read, owner-only write/create.
    match /timerSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // ── Groups ──
    // Members can read, admin can write. Users join only via invitation acceptance.
    match /groups/{groupId} {
      allow read: if isAuthenticated() && isGroupMember(resource.data);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.adminId;
      allow update: if isAuthenticated() && isGroupAdmin(resource.data);
      allow delete: if isAuthenticated() && isGroupAdmin(resource.data);

      // ── Group Messages (subcollection) ──
      // Group members can read and create messages.
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow create: if isAuthenticated()
          && request.auth.uid == request.resource.data.userId
          && isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow update, delete: if false;
      }
    }

    // ── Group Invitations ──
    // Admin (sender) can create, recipient can update status, both can read.
    match /groupInvitations/{invitationId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.fromUserId;
      allow update: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
      allow delete: if false;
    }

    // ── Tracked Habits ──
    // Owner can create/delete their own entries, group members can read.
    match /trackedHabits/{trackedHabitId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow update: if false;
    }

    // ── Group Activities ──
    // Group members can read, members can create, no direct deletes.
    match /groupActivities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // ── Blocks ──
    // Create/delete are owner-only (blockerId). Read is allowed for either party
    // (blocker or blocked) so both clients can build the bidirectional filter set.
    // Blocks are never mutated.
    match /blocks/{blockId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.blockerId
            || request.auth.uid == resource.data.blockedUserId);
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.blockerId;
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.blockerId;
      allow update: if false;
    }

    // ── Reports ──
    // Create-only, reporterId must be the caller. Reporter can read their own
    // reports (for auto-hide). Reports are immutable: never updatable or deletable.
    match /reports/{reportId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.reporterId;
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.reporterId;
      allow update, delete: if false;
    }

    // ── Feedback (in-app ratings & feedback) ──
    // Write-only from the client: any authenticated user can submit feedback.
    // Clients never read feedback back (reviewed via Firebase console only).
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }
  }
}

// Deploy manually after merging to main (from GoalStreakApp/firebase/):
//   firebase deploy --only firestore:rules --project goalstreak-app2
