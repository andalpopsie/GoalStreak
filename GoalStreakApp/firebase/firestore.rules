rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──

    // Check if the requesting user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the requesting user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the requesting user is a member of a group
    function isGroupMember(groupData) {
      return isAuthenticated() && request.auth.uid in groupData.memberIds;
    }

    // Check if the requesting user is the admin of a group
    function isGroupAdmin(groupData) {
      return isAuthenticated() && request.auth.uid == groupData.adminId;
    }

    // Does the caller hold a pending invitation to this group? Invitations use
    // the deterministic id "{groupId}_{uid}" so the rule can look one up.
    function hasPendingGroupInvite(groupId) {
      let invId = groupId + '_' + request.auth.uid;
      return exists(/databases/$(database)/documents/groupInvitations/$(invId))
        && get(/databases/$(database)/documents/groupInvitations/$(invId)).data.status == 'pending';
    }

    // Allow an invited user to add ONLY themselves to a group's member arrays
    // (accepting an invitation). Guards: caller is newly added, exactly one
    // member added (the caller), no members removed, and only the membership
    // fields change — nothing else (adminId, name, etc.) can be touched.
    function isSelfJoin(groupId) {
      return (request.auth.uid in request.resource.data.memberIds)
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberIds', 'updatedAt'])
        && hasPendingGroupInvite(groupId);
    }

    // Is the caller the admin of the group with this id? (Used by sibling
    // collections — trackedHabits, groupActivities — that reference groupId.)
    function isGroupAdminOf(groupId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.adminId == request.auth.uid;
    }

    // Is the caller a member of the group with this id? (For sibling collections
    // that reference groupId, e.g. reacting on a group activity.)
    function isGroupMemberOf(groupId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Allow a member to remove ONLY themselves from a group (leaving). Mirror
    // of isSelfJoin: caller is removed, exactly one member removed (the caller),
    // no one added, and only the membership fields change.
    function isSelfLeave() {
      return (request.auth.uid in resource.data.memberIds)
        && !(request.auth.uid in request.resource.data.memberIds)
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberIds', 'updatedAt']);
    }

    // ── Users ──
    // Any authenticated user can read profiles (needed for friend suggestions,
    // search, and displaying names/avatars in the social feed and groups).
    // Only the owner can write their own profile.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ── User Profiles (social profile mirror; doc id = userId) ──
    // Authenticated users can read (friend search by email, names/avatars in
    // requests and feed). Only the owner can write/delete their own profile.
    // Founding fields (foundingMember, foundingNumber, foundingRecord) are
    // server-authoritative and must never be written by a client — the Cloud
    // Function uses the Admin SDK which bypasses these rules.
    match /userProfiles/{userId} {
      allow read: if isAuthenticated();
      // create: owner-only. No diff guard needed — the doc doesn't exist yet
      // so resource.data is null; the Cloud Function will write founding fields
      // via the Admin SDK (bypasses rules) regardless.
      allow create: if isOwner(userId);
      // update/delete: owner-only, AND must not touch the server-authoritative
      // founding fields (foundingMember, foundingNumber, foundingRecord).
      // resource.data is always non-null for update/delete. (R6.6, R6.7)
      allow update, delete: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['foundingMember', 'foundingNumber', 'foundingRecord']);
    }

    // ── Social Settings (doc id = userId) ──
    // Authenticated users can read (e.g. checking a recipient's notification
    // preference before notifying). Only the owner can write their settings.
    match /socialSettings/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ── Usernames (uniqueness registry; doc id = username → { userId }) ──
    // Anyone authenticated can read for availability checks. A user may only
    // reserve/release a username tied to their own uid. Usernames are immutable.
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow update: if false;
    }

    // ── Habits ──
    match /habits/{habitId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // ── Completions ──
    match /completions/{completionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // ── Streaks ──
    match /streaks/{streakId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Friends ──
    // Read: only the two parties in the friendship can read a friend doc.
    // Create: caller must be one of the two parties — allows acceptFriendRequest()
    //   to batch-write both directional docs in a single transaction (the
    //   accepting user is always either userId or friendId in each doc) while
    //   preventing any user from fabricating friend records between two other users.
    // Update/Delete: only a participant can modify or remove a friendship record.
    //   Covers removeFriend() and blockUser().
    match /friends/{friendId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.userId
            || request.auth.uid == resource.data.friendId);
      allow create: if isAuthenticated()
        && (request.auth.uid == request.resource.data.userId
            || request.auth.uid == request.resource.data.friendId);
      allow update, delete: if isAuthenticated()
        && (request.auth.uid == resource.data.userId
            || request.auth.uid == resource.data.friendId);
    }

    // ── Friend Requests ──
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.fromUserId;
      allow update: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
    }

    // ── Activities (main feed) ──
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      // Author creates/deletes their own activity.
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      // Author may fully update their own activity. Any authenticated user may
      // react to another user's activity — an update that touches ONLY the
      // reaction-related fields (mirrors the social feed where you react to
      // friends' posts). Prevents feed tampering while allowing reactions.
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reactions', 'updatedAt', 'lastReactionAt'])
      );
    }

    // ── Comments (on activity feed posts) ──
    // Any authenticated user can read comments (mirrors activity feed reads).
    // Author can create their own comment; comments are immutable.
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    // ── Timer States ──
    match /timerStates/{timerId} {
      allow read, write: if isAuthenticated();
    }

    // ── Timer Sessions (completed timer records; has userId) ──
    // Mirrors completions: authenticated read, owner-only write/create.
    match /timerSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // ── Groups ──
    // Members can read, admin can write. Users join only via invitation acceptance.
    match /groups/{groupId} {
      // Any authenticated user can read group metadata (needed so an invited
      // user can view the group before accepting, and for group discovery).
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.adminId;
      // Admin can update freely; an invited user may add only themselves
      // (accept), and a member may remove only themselves (leave).
      allow update: if isAuthenticated()
        && (isGroupAdmin(resource.data) || isSelfJoin(groupId) || isSelfLeave());
      allow delete: if isAuthenticated() && isGroupAdmin(resource.data);

      // ── Group Messages (subcollection) ──
      // Group members can read and create messages.
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow create: if isAuthenticated()
          && request.auth.uid == request.resource.data.userId
          && isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow update, delete: if false;
      }
    }

    // ── Group Invitations ──
    // Admin (sender) can create, recipient can update status, both can read.
    match /groupInvitations/{invitationId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.fromUserId;
      allow update: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
      allow delete: if false;
    }

    // ── Tracked Habits ──
    // Owner can create/delete their own entries, group members can read.
    match /trackedHabits/{trackedHabitId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      // Owner can unlink their own; group admin can remove a member's tracked
      // habits when removing that member from the group.
      allow delete: if isAuthenticated()
        && (request.auth.uid == resource.data.userId || isGroupAdminOf(resource.data.groupId));
      allow update: if false;
    }

    // ── Group Activities ──
    // Group members can read, members can create, no direct deletes.
    match /groupActivities/{activityId} {
      allow read: if isAuthenticated();
      // Self-authored activities (habit_completed, member_joined), or the group
      // admin posting system events about a member (e.g. member_left on removal).
      allow create: if isAuthenticated()
        && (request.auth.uid == request.resource.data.userId
            || isGroupAdminOf(request.resource.data.groupId));
      // Only a group member may update, and only the reactions field (plus
      // updatedAt) — so reacting works but feed content can't be tampered with.
      allow update: if isAuthenticated()
        && isGroupMemberOf(resource.data.groupId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reactions', 'updatedAt']);
      allow delete: if false;
    }

    // ── Blocks ──
    // Create/delete are owner-only (blockerId). Read is allowed for either party
    // (blocker or blocked) so both clients can build the bidirectional filter set.
    // Blocks are never mutated.
    match /blocks/{blockId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.blockerId
            || request.auth.uid == resource.data.blockedUserId);
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.blockerId;
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.blockerId;
      allow update: if false;
    }

    // ── Reports ──
    // Create-only, reporterId must be the caller. Reporter can read their own
    // reports (for auto-hide). Reports are immutable: never updatable or deletable.
    match /reports/{reportId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.reporterId;
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.reporterId;
      allow update, delete: if false;
    }

    // ── Feedback (in-app ratings & feedback) ──
    // Write-only from the client: any authenticated user can submit feedback.
    // Clients never read feedback back (reviewed via Firebase console only).
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // ── Founding Member: public counter (R10.1, R10.5) ──
    // Landing page reads this unauthenticated to show the scarcity indicator.
    // Only the Admin SDK (Cloud Functions) may write — clients never can.
    match /counters/{docId} {
      allow read: if true;        // public — landing page reads this unauthenticated
      allow write: if false;      // Admin SDK only
    }

    // ── Founding Member: operator config (R4.2) ──
    // Authenticated app clients may read (e.g. T0 display). Admin SDK only writes.
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;      // Admin SDK only
    }
  }
}

// Deploy manually after merging to main (from GoalStreakApp/firebase/):
//   firebase deploy --only firestore:rules --project goalstreak-app2
