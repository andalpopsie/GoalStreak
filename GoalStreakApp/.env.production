# GoalStreak Production Environment Configuration
# Optimized for minimal logging and cost efficiency

# Environment
EXPO_PUBLIC_ENVIRONMENT=production

# App Configuration
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_BUILD_NUMBER=1

# Analytics Configuration - Minimal logging for production
EXPO_PUBLIC_ANALYTICS_ENABLED=true
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_LOG_LEVEL=error
EXPO_PUBLIC_ENABLE_SMART_LOGGING=true

# Firebase Production Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCvIcGr7R1NB8hT7jZ3M5771w5anY1KMtU
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=goalstreak-app2.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=goalstreak-app2
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=goalstreak-app2.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=233571046472
EXPO_PUBLIC_FIREBASE_APP_ID=1:233571046472:web:020727b78eec425fd0347d
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-Y482L51QEC

# API Configuration
EXPO_PUBLIC_API_BASE_URL=https://api.goalstreak.co

# Feature Flags - Production optimized
EXPO_PUBLIC_ENABLE_CRASHLYTICS=true
EXPO_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
EXPO_PUBLIC_ENABLE_ANALYTICS=true

# Production Settings - Minimal logging
EXPO_PUBLIC_LOG_LEVEL=error
EXPO_PUBLIC_MOCK_DATA=false
EXPO_PUBLIC_ANALYTICS_SAMPLING_RATE=0.1
EXPO_PUBLIC_PERFORMANCE_SAMPLING_RATE=0.2

# RevenueCat (iOS only) — publishable client SDK key (appl_...), safe to ship
# in the binary (same class as the Firebase EXPO_PUBLIC_* keys above).
# Also mirrored as an EAS project secret for redundancy.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_sjBceswlYDThWxWYsidrNttXMXR

# SSO / OAuth client identifiers (EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID,
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID, EXPO_PUBLIC_APPLE_CLIENT_ID) are intentionally
# NOT declared here (R9.3). They are injected from EAS secrets at build time; the
# Apple .p8 key lives only in the Firebase Console.
